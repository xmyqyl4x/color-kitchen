{
  "name": "color-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/http/cli.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/src/http/cli.js",
    "release:rehearse": "npm run build --silent && node dist/tests/rehearse-release.js",
    "release:gate": "npm run build --silent && node dist/src/release/gate-cli.js",
    "release:rollout": "npm run build --silent && node dist/tests/local-rollout.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run build --silent && node dist/src/db/cli.js",
    "db:seed": "npm run build --silent && node dist/src/catalog/seed-cli.js",
    "test": "npm run build --silent && node --test \"dist/tests/*.test.js\""
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "ai": "7.0.179",
    "intl-messageformat": "12.2.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "playwright": "1.62.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tailwindcss-v3": "npm:tailwindcss@3.4.19",
    "typescript": "6.0.3"
  }
}
