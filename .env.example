# Local development. Update DATABASE_URL if you change the disposable PostgreSQL settings.
DATABASE_URL=postgresql://ck_dev:ck_dev_local@127.0.0.1:55432/color_kitchen_test

# Leave HOST and PORT unset to use 127.0.0.1:3000 for a directly launched server.
# For a reverse proxy or a production runtime, supply the browser-facing origin explicitly.
# Production example: COLOR_KITCHEN_ORIGIN=https://color-kitchen.com
# COLOR_KITCHEN_ORIGIN=http://127.0.0.1:3000
# COLOR_KITCHEN_INDEXING=false

# Optional server-side PostgreSQL tuning.
# COLOR_KITCHEN_DB_POOL_MAX=10
# COLOR_KITCHEN_DB_CONNECT_TIMEOUT_MS=3000
# COLOR_KITCHEN_DB_STATEMENT_TIMEOUT_MS=5000

# Optional overrides for the disposable PostgreSQL Compose service.
# COLOR_KITCHEN_DEV_DB_PORT=55432
# COLOR_KITCHEN_DEV_DB_USER=ck_dev
# COLOR_KITCHEN_DEV_DB_PASSWORD=ck_dev_local

# See docs/environment-configuration.md for optional integrations and secret settings.
