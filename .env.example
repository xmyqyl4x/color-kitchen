# PostgreSQL connection URL (omit for local/preview in-memory catalog fallback).
# Cloud Run + Cloud SQL Unix socket format:
# DATABASE_URL=postgresql://DB_USER:URL_ENCODED_PASSWORD@localhost/DB_NAME?host=%2Fcloudsql%2FPROJECT_ID%3AREGION%3AINSTANCE_ID
DATABASE_URL=

# Listener settings.
# Do NOT set PORT as a custom env var in Cloud Run (Cloud Run injects PORT automatically; set Container port instead).
# HOST=0.0.0.0
# PORT=3000

# Public origin, indexing, and consented measurement.
# Production example: COLOR_KITCHEN_ORIGIN=https://color-kitchen.com
COLOR_KITCHEN_ORIGIN=
COLOR_KITCHEN_INDEXING=
COLOR_KITCHEN_MEASUREMENT=

# Optional PostgreSQL pool tuning.
# COLOR_KITCHEN_DB_POOL_MAX=10
# COLOR_KITCHEN_DB_CONNECT_TIMEOUT_MS=3000
# COLOR_KITCHEN_DB_STATEMENT_TIMEOUT_MS=5000

# Optional Cookie Preferences & measurement signing keys (64-char hex secrets).
COLOR_KITCHEN_CONSENT_KEY=
COLOR_KITCHEN_EVENT_KEY=

# Optional Hosted Color Guide (local Guide works without these).
AI_GATEWAY_API_KEY=
COLOR_KITCHEN_GUIDE_MODEL=
COLOR_KITCHEN_GUIDE_REQUESTS_PER_MINUTE=
COLOR_KITCHEN_GUIDE_DAILY_UNITS=

# Optional Staff & project sign-in (set all three together).
COLOR_KITCHEN_IDENTITY_ISSUER=
COLOR_KITCHEN_IDENTITY_AUDIENCE=
COLOR_KITCHEN_IDENTITY_PUBLIC_KEY=

# Optional Inquiry encryption & delivery (see docs/environment-configuration.md).
COLOR_KITCHEN_CONTACT_KEY_ID=
COLOR_KITCHEN_CONTACT_ENCRYPT_KEY=
COLOR_KITCHEN_CONTACT_HMAC_KEY=
COLOR_KITCHEN_CONTACT_RETENTION_DAYS=
COLOR_KITCHEN_INQUIRY_WEBHOOK=
COLOR_KITCHEN_INQUIRY_TOKEN=
COLOR_KITCHEN_INQUIRY_DEDUP_MS=

# Optional approved HTTPS ad frame URL.
COLOR_KITCHEN_AD_FRAME_URL=